---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('writing');
const sortedPosts = allPosts.sort((a, b) => {
  if (a.slug === 'pratigya-abhiyan') return -1;
  if (b.slug === 'pratigya-abhiyan') return 1;
  return b.data.date.valueOf() - a.data.date.valueOf();
});

const streams = [
  { id: 'all', label: 'All' },
  { id: 'memoirs', label: 'Memoirs & Pratigya' },
  { id: 'poetry', label: 'Poetry (काव्य)' },
  { id: 'philosophy', label: 'Philosophy' },
  { id: 'ai-research', label: 'Research Notes' },
];
---

<BaseLayout
  title="Writing & Notes — Prateek Mittal"
  description="Essays, poetry, memoirs, and technical notes by Prateek Mittal."
>
  <div class="max-w-2xl mx-auto px-6 py-14 sm:py-20 space-y-10">
    <!-- Header -->
    <div class="space-y-3">
      <h1 class="text-3xl sm:text-4xl font-serif font-medium text-warm-900 dark:text-warm-50 tracking-tight">
        Writing & Poetry
      </h1>
      <p class="text-stone-600 dark:text-stone-400 font-sans text-sm leading-relaxed">
        Essays, memoirs from Pratigya Abhiyan, Hindi & English verse, and notes on medical AI and philosophy.
      </p>
    </div>

    <!-- Category Filter Bar -->
    <div class="flex flex-wrap gap-2 border-b border-warm-200 dark:border-warm-800 pb-4 text-xs font-sans" id="stream-filters">
      {streams.map((stream) => (
        <button
          type="button"
          data-stream={stream.id}
          class={`px-3 py-1 rounded-full transition-colors ${
            stream.id === 'all'
              ? 'bg-warm-900 text-warm-50 dark:bg-warm-100 dark:text-warm-900 font-medium'
              : 'text-stone-600 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-100 bg-warm-100/60 dark:bg-warm-800/40'
          }`}
        >
          {stream.label}
        </button>
      ))}
    </div>

    <!-- Articles List -->
    <div class="space-y-8" id="posts-grid">
      {sortedPosts.map((post) => (
        <article
          data-category={post.data.category}
          class="post-item space-y-1.5 group"
        >
          <div class="flex items-baseline justify-between gap-4">
            <h2 class="text-xl font-serif font-medium text-stone-900 dark:text-stone-100 group-hover:text-terracotta-500 transition-colors">
              <a href={`/writing/${post.slug}`}>
                {post.data.title}
              </a>
            </h2>
            <time datetime={post.data.date.toISOString()} class="text-xs font-sans text-stone-400 flex-shrink-0">
              {new Intl.DateTimeFormat('en-US', { month: 'short', year: 'numeric' }).format(post.data.date)}
            </time>
          </div>

          <p class="text-sm text-stone-600 dark:text-stone-400 leading-relaxed font-serif">
            {post.data.description}
          </p>

          <div class="text-xs font-sans text-stone-400 pt-0.5">
            <span class="text-terracotta-500 uppercase tracking-wider text-[11px] font-semibold">
              {post.data.category === 'poetry' ? 'Poetry' : post.data.category === 'memoirs' ? 'Memoir' : post.data.category === 'philosophy' ? 'Philosophy' : 'Research'}
            </span>
            <span>·</span>
            <span>{post.data.readingTime || '5 min read'}</span>
          </div>
        </article>
      ))}
    </div>

    <div id="no-results" class="hidden text-center py-12 text-stone-400 font-serif italic text-sm">
      No writings found in this category.
    </div>
  </div>
</BaseLayout>

<script is:inline>
  const filterButtons = document.querySelectorAll('#stream-filters button');
  const postItems = document.querySelectorAll('.post-item');
  const noResults = document.getElementById('no-results');

  filterButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterButtons.forEach((b) => {
        b.classList.remove('bg-warm-900', 'text-warm-50', 'dark:bg-warm-100', 'dark:text-warm-900', 'font-medium');
        b.classList.add('text-stone-600', 'dark:text-stone-400');
      });
      btn.classList.add('bg-warm-900', 'text-warm-50', 'dark:bg-warm-100', 'dark:text-warm-900', 'font-medium');
      btn.classList.remove('text-stone-600', 'dark:text-stone-400');

      const stream = btn.getAttribute('data-stream');
      let count = 0;
      postItems.forEach((item) => {
        const cat = item.getAttribute('data-category');
        if (stream === 'all' || cat === stream) {
          item.style.display = 'block';
          count++;
        } else {
          item.style.display = 'none';
        }
      });

      if (noResults) {
        if (count === 0) noResults.classList.remove('hidden');
        else noResults.classList.add('hidden');
      }
    });
  });
</script>
