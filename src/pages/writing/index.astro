---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('writing');
const sortedPosts = allPosts.sort((a, b) => {
  if (a.slug === 'pratigya-abhiyan') return -1;
  if (b.slug === 'pratigya-abhiyan') return 1;
  return b.data.date.valueOf() - a.data.date.valueOf();
});

const streams = [
  { id: 'all', label: 'All Writings' },
  { id: 'memoirs', label: 'Memoirs & Grassroots' },
  { id: 'poetry', label: 'Poetry (काव्य)' },
  { id: 'philosophy', label: 'Philosophy & Ethics' },
  { id: 'ai-research', label: 'AI & Science Notes' },
];
---

<BaseLayout
  title="Writing & Poetry — Prateek Mittal"
  description="Essays, memoirs from Pratigya Abhiyan, Hindi & English verse, and research notes by Prateek Mittal."
>
  <div class="max-w-5xl mx-auto px-6 sm:px-8 py-8 sm:py-12 space-y-10 sm:space-y-12">
    <!-- Header -->
    <div class="space-y-3 border-b border-warm-200 dark:border-warm-800 pb-6">
      <h1 class="text-3xl sm:text-4xl font-serif font-medium text-warm-900 dark:text-warm-50 tracking-tight">
        Writings, Poetry & Essays
      </h1>
      <p class="text-stone-600 dark:text-stone-400 font-sans text-sm leading-relaxed max-w-2xl text-left">
        A collection of essays on healthcare AI governance, grassroots education memoirs from Pratigya Abhiyan, notes on differential geometry, and contemplative verse in Hindi and English.
      </p>
    </div>

    <!-- Category Filter Bar -->
    <div class="flex flex-wrap gap-2 border-b border-warm-200 dark:border-warm-800 pb-4 text-xs font-sans" id="stream-filters">
      {streams.map((stream) => (
        <button
          type="button"
          data-stream={stream.id}
          class={`px-3.5 py-1.5 rounded-full transition-colors ${
            stream.id === 'all'
              ? 'bg-warm-900 text-warm-50 dark:bg-warm-100 dark:text-warm-900 font-medium'
              : 'text-stone-600 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-100 bg-warm-100 dark:bg-warm-800/60'
          }`}
        >
          {stream.label}
        </button>
      ))}
    </div>

    <!-- Articles Grid: 2-Column Responsive Layout -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="posts-grid">
      {sortedPosts.map((post) => (
        <article
          data-category={post.data.category}
          class="post-item p-6 rounded-xl border border-warm-200 dark:border-warm-800 bg-warm-50/60 dark:bg-warm-900/40 hover:border-brick-500/50 transition-all flex flex-col justify-between space-y-4 group"
        >
          <div class="space-y-2.5">
            <div class="flex items-center justify-between text-xs font-sans text-stone-400">
              <span class="text-brick-600 dark:text-brick-500 font-medium uppercase text-[11px] tracking-wider">
                {post.data.category === 'poetry' ? 'Poetry' : post.data.category === 'memoirs' ? 'Memoir' : post.data.category === 'philosophy' ? 'Philosophy' : 'AI & Science'}
              </span>
              <time datetime={post.data.date.toISOString()}>
                {new Intl.DateTimeFormat('en-US', { month: 'short', year: 'numeric' }).format(post.data.date)}
              </time>
            </div>

            <h2 class="text-xl font-serif font-medium text-stone-900 dark:text-stone-100 group-hover:text-brick-600 dark:group-hover:text-brick-500 transition-colors leading-snug">
              <a href={`/writing/${post.slug}`}>
                {post.data.title}
              </a>
            </h2>

            <p class="text-sm text-stone-600 dark:text-stone-400 font-sans line-clamp-3 leading-relaxed text-left">
              {post.data.description}
            </p>
          </div>

          <div class="pt-2 text-xs font-sans text-brick-600 dark:text-brick-500 font-medium flex items-center justify-between border-t border-warm-200/60 dark:border-warm-800/60">
            <span>{post.data.readingTime || '5 min read'}</span>
            <a href={`/writing/${post.slug}`} class="group-hover:translate-x-0.5 transition-transform">
              Read piece &rarr;
            </a>
          </div>
        </article>
      ))}
    </div>

    <div id="no-results" class="hidden text-center py-16 text-stone-400 font-sans text-sm">
      No writings found in this category.
    </div>
  </div>
</BaseLayout>

<script is:inline>
  const filterButtons = document.querySelectorAll('#stream-filters button');
  const postItems = document.querySelectorAll('.post-item');
  const noResults = document.getElementById('no-results');

  filterButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterButtons.forEach((b) => {
        b.classList.remove('bg-warm-900', 'text-warm-50', 'dark:bg-warm-100', 'dark:text-warm-900', 'font-medium');
        b.classList.add('text-stone-600', 'dark:text-stone-400');
      });
      btn.classList.add('bg-warm-900', 'text-warm-50', 'dark:bg-warm-100', 'dark:text-warm-900', 'font-medium');
      btn.classList.remove('text-stone-600', 'dark:text-stone-400');

      const stream = btn.getAttribute('data-stream');
      let count = 0;
      postItems.forEach((item) => {
        const cat = item.getAttribute('data-category');
        if (stream === 'all' || cat === stream) {
          item.style.display = 'flex';
          count++;
        } else {
          item.style.display = 'none';
        }
      });

      if (noResults) {
        if (count === 0) noResults.classList.remove('hidden');
        else noResults.classList.add('hidden');
      }
    });
  });
</script>
