---
import BaseLayout from '../layouts/BaseLayout.astro';
import { experiences, education } from '../data/experience';
import { profile } from '../data/profile';

const industryExp = experiences.filter((e) => e.type === 'industry');
const researchExp = experiences.filter((e) => e.type === 'research');
const leadershipExp = experiences.filter((e) => e.type === 'leadership' || e.type === 'grassroots');
---

<BaseLayout
  title="Journey & Background — Prateek Mittal"
  description="Career timeline, research experience at Yale and VEDAs Lab, industry work at Accenture and Lal PathLabs, education, and initiatives."
>
  <div class="max-w-2xl mx-auto px-6 py-14 sm:py-20 space-y-14">
    
    <!-- Page Header -->
    <div class="space-y-3 pb-2">
      <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
        <h1 class="text-3xl sm:text-4xl font-serif font-medium text-warm-900 dark:text-warm-50 tracking-tight">
          Journey & Background
        </h1>
      </div>
      <p class="text-stone-600 dark:text-stone-400 font-sans text-sm leading-relaxed">
        A chronological overview of my work across industry decision science, medical AI research, education, and initiatives.
      </p>
    </div>

    <!-- 1. Industry Experience -->
    <section class="border-t border-warm-200 dark:border-warm-800 pt-8 space-y-6">
      <h2 class="text-xs uppercase tracking-widest text-terracotta-500 font-sans font-semibold">
        Industry & Enterprise
      </h2>

      <div class="space-y-8">
        {industryExp.map((item) => (
          <div class="space-y-2">
            <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
              <h3 class="font-serif font-medium text-lg text-stone-900 dark:text-stone-100">
                {item.role}
              </h3>
              <span class="text-xs font-sans text-stone-500 dark:text-stone-400">
                {item.period}
              </span>
            </div>
            
            <div class="text-xs font-sans text-terracotta-500 font-medium">
              {item.organization} <span class="text-stone-400 font-normal">· {item.location}</span>
            </div>

            <ul class="space-y-1.5 text-sm text-stone-700 dark:text-stone-300 list-disc list-outside pl-4 font-sans leading-relaxed pt-1">
              {item.description.map((d) => (
                <li>{d}</li>
              ))}
            </ul>

            {item.skills && (
              <div class="flex flex-wrap gap-1.5 pt-1.5">
                {item.skills.map((s) => (
                  <span class="text-[11px] font-sans text-stone-500 dark:text-stone-400 bg-warm-100 dark:bg-warm-800/60 px-2 py-0.5 rounded">
                    {s}
                  </span>
                ))}
              </div>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- 2. Academic Research Experience -->
    <section class="border-t border-warm-200 dark:border-warm-800 pt-8 space-y-6">
      <h2 class="text-xs uppercase tracking-widest text-terracotta-500 font-sans font-semibold">
        Academic Research
      </h2>

      <div class="space-y-8">
        {researchExp.map((item) => (
          <div class="space-y-2">
            <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
              <h3 class="font-serif font-medium text-lg text-stone-900 dark:text-stone-100">
                {item.role}
              </h3>
              <span class="text-xs font-sans text-stone-500 dark:text-stone-400">
                {item.period}
              </span>
            </div>
            
            <div class="text-xs font-sans text-terracotta-500 font-medium">
              {item.organization} <span class="text-stone-400 font-normal">· {item.location}</span>
            </div>

            <ul class="space-y-1.5 text-sm text-stone-700 dark:text-stone-300 list-disc list-outside pl-4 font-sans leading-relaxed pt-1">
              {item.description.map((d) => (
                <li>{d}</li>
              ))}
            </ul>

            {item.skills && (
              <div class="flex flex-wrap gap-1.5 pt-1.5">
                {item.skills.map((s) => (
                  <span class="text-[11px] font-sans text-stone-500 dark:text-stone-400 bg-warm-100 dark:bg-warm-800/60 px-2 py-0.5 rounded">
                    {s}
                  </span>
                ))}
              </div>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- 3. Education -->
    <section class="border-t border-warm-200 dark:border-warm-800 pt-8 space-y-6">
      <h2 class="text-xs uppercase tracking-widest text-terracotta-500 font-sans font-semibold">
        Education
      </h2>

      <div class="space-y-6">
        {education.map((edu) => (
          <div class="space-y-1 text-sm font-sans">
            <div class="flex items-baseline justify-between gap-4">
              <h3 class="font-serif font-medium text-base text-stone-900 dark:text-stone-100">
                {edu.degree}
              </h3>
              <span class="text-xs text-stone-500 dark:text-stone-400">{edu.timeline}</span>
            </div>
            <div class="text-xs text-stone-600 dark:text-stone-400">
              {edu.institution} — <span class="font-semibold text-stone-900 dark:text-stone-100">{edu.score}</span>
            </div>
            {edu.details && (
              <p class="text-xs text-stone-500 pt-0.5">{edu.details}</p>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- 4. Leadership & Social Action -->
    <section class="border-t border-warm-200 dark:border-warm-800 pt-8 space-y-6">
      <h2 class="text-xs uppercase tracking-widest text-terracotta-500 font-sans font-semibold">
        Initiatives & Social Action
      </h2>

      <div class="space-y-8">
        {leadershipExp.map((item) => (
          <div class="space-y-2">
            <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
              <h3 class="font-serif font-medium text-lg text-stone-900 dark:text-stone-100">
                {item.role}
              </h3>
              <span class="text-xs font-sans text-stone-500 dark:text-stone-400">
                {item.period}
              </span>
            </div>
            
            <div class="text-xs font-sans text-terracotta-500 font-medium">
              {item.organization} <span class="text-stone-400 font-normal">· {item.location}</span>
            </div>

            <ul class="space-y-1.5 text-sm text-stone-700 dark:text-stone-300 list-disc list-outside pl-4 font-sans leading-relaxed pt-1">
              {item.description.map((d) => (
                <li>{d}</li>
              ))}
            </ul>

            {item.link && (
              <div class="pt-1">
                <a
                  href={item.link}
                  class="text-xs font-sans text-terracotta-500 hover:underline inline-flex items-center gap-1 font-medium"
                >
                  Read detailed memoir & documentation &rarr;
                </a>
              </div>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- 5. Distinctions & Reviewing -->
    <section class="border-t border-warm-200 dark:border-warm-800 pt-8 space-y-6">
      <h2 class="text-xs uppercase tracking-widest text-terracotta-500 font-sans font-semibold">
        Honors & Academic Service
      </h2>

      <div class="space-y-4 text-sm font-sans">
        <ul class="space-y-2 text-xs text-stone-700 dark:text-stone-300">
          {profile.awards.map((a) => (
            <li>
              <strong>{a.title} ({a.year})</strong> — {a.description}
            </li>
          ))}
        </ul>

        <div class="pt-2">
          <span class="text-xs font-medium text-stone-500 dark:text-stone-400 block mb-1.5">
            Scholarly Reviewer:
          </span>
          <ul class="space-y-1 text-xs text-stone-600 dark:text-stone-400">
            {profile.service.map((s) => (
              <li>· {s}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>
