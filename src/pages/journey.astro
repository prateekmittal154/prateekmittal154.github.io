---
import BaseLayout from '../layouts/BaseLayout.astro';
import { experiences, education } from '../data/experience';
import { profile } from '../data/profile';
import { mentors } from '../data/mentors';

const industryExp = experiences.filter((e) => e.type === 'industry');
const researchExp = experiences.filter((e) => e.type === 'research');
const leadershipExp = experiences.filter((e) => e.type === 'leadership' || e.type === 'grassroots');
---

<BaseLayout
  title="Journey & Background — Prateek Mittal"
  description="Career timeline, research experience at Yale and VEDAs Lab, industry work at Accenture and Lal PathLabs, education, and initiatives."
>
  <div class="max-w-5xl mx-auto px-6 sm:px-8 py-8 sm:py-12 space-y-12 sm:space-y-14">
    
    <!-- Page Header -->
    <div class="space-y-3 border-b border-warm-200 dark:border-warm-800 pb-6">
      <h1 class="text-3xl sm:text-4xl font-serif font-medium text-warm-900 dark:text-warm-50 tracking-tight">
        Journey & Background
      </h1>
      <p class="text-stone-600 dark:text-stone-400 font-sans text-sm leading-relaxed max-w-2xl text-left">
        A chronological overview of my work across industry decision science, medical AI research, education, and social initiatives.
      </p>
    </div>

    <!-- 1. Industry & Enterprise Experience -->
    <section class="space-y-8">
      <div class="space-y-1">
        <h2 class="text-xs uppercase tracking-widest text-brick-600 dark:text-brick-500 font-sans font-semibold">
          Industry & Enterprise
        </h2>
        <p class="text-xs text-stone-500 font-sans">
          Production GenAI, decision analytics, and clinical operations.
        </p>
      </div>

      <div class="divide-y divide-warm-200 dark:divide-warm-800">
        {industryExp.map((item) => (
          <div class="py-6 first:pt-0 grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-8 items-start">
            <!-- Left: Timeline Date -->
            <div class="md:col-span-3 text-xs font-sans text-stone-500 dark:text-stone-400 font-medium md:pt-1">
              {item.period}
            </div>

            <!-- Right: Content -->
            <div class="md:col-span-9 space-y-3">
              <div>
                <h3 class="font-serif font-medium text-xl text-stone-900 dark:text-stone-100">
                  {item.role}
                </h3>
                <div class="text-xs font-sans text-brick-600 dark:text-brick-500 font-medium pt-0.5">
                  {item.organization} <span class="text-stone-400 font-normal">· {item.location}</span>
                </div>
              </div>

              <ul class="space-y-2 text-sm text-stone-700 dark:text-stone-300 list-disc list-outside pl-4 font-sans leading-relaxed text-left">
                {item.description.map((d) => (
                  <li>{d}</li>
                ))}
              </ul>

              {item.skills && (
                <div class="flex flex-wrap gap-1.5 pt-1">
                  {item.skills.map((s) => (
                    <span class="text-[11px] font-sans text-stone-600 dark:text-stone-400 bg-warm-100 dark:bg-warm-800/60 px-2.5 py-0.5 rounded border border-warm-200/80 dark:border-warm-700/60">
                      {s}
                    </span>
                  ))}
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 2. Academic Research Experience -->
    <section class="border-t border-warm-200 dark:border-warm-800 pt-10 space-y-8">
      <div class="space-y-1">
        <h2 class="text-xs uppercase tracking-widest text-brick-600 dark:text-brick-500 font-sans font-semibold">
          Academic Research
        </h2>
        <p class="text-xs text-stone-500 font-sans">
          Medical foundation models, differential geometry, and theoretical machine learning.
        </p>
      </div>

      <div class="divide-y divide-warm-200 dark:divide-warm-800">
        {researchExp.map((item) => (
          <div class="py-6 first:pt-0 grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-8 items-start">
            <!-- Left: Timeline Date -->
            <div class="md:col-span-3 text-xs font-sans text-stone-500 dark:text-stone-400 font-medium md:pt-1">
              {item.period}
            </div>

            <!-- Right: Content -->
            <div class="md:col-span-9 space-y-3">
              <div>
                <h3 class="font-serif font-medium text-xl text-stone-900 dark:text-stone-100">
                  {item.role}
                </h3>
                <div class="text-xs font-sans text-brick-600 dark:text-brick-500 font-medium pt-0.5">
                  {item.organization} <span class="text-stone-400 font-normal">· {item.location}</span>
                </div>
              </div>

              <ul class="space-y-2 text-sm text-stone-700 dark:text-stone-300 list-disc list-outside pl-4 font-sans leading-relaxed text-left">
                {item.description.map((d) => (
                  <li>{d}</li>
                ))}
              </ul>

              {item.skills && (
                <div class="flex flex-wrap gap-1.5 pt-1">
                  {item.skills.map((s) => (
                    <span class="text-[11px] font-sans text-stone-600 dark:text-stone-400 bg-warm-100 dark:bg-warm-800/60 px-2.5 py-0.5 rounded border border-warm-200/80 dark:border-warm-700/60">
                      {s}
                    </span>
                  ))}
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 3. Education -->
    <section class="border-t border-warm-200 dark:border-warm-800 pt-10 space-y-8">
      <div class="space-y-1">
        <h2 class="text-xs uppercase tracking-widest text-brick-600 dark:text-brick-500 font-sans font-semibold">
          Education
        </h2>
        <p class="text-xs text-stone-500 font-sans">
          Academic degrees and specialization in computer engineering and artificial intelligence.
        </p>
      </div>

      <div class="divide-y divide-warm-200 dark:divide-warm-800">
        {education.map((edu) => (
          <div class="py-5 first:pt-0 grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-8 items-start">
            <div class="md:col-span-3 text-xs font-sans text-stone-500 dark:text-stone-400 font-medium md:pt-1">
              {edu.timeline}
            </div>
            <div class="md:col-span-9 space-y-1">
              <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
                <h3 class="font-serif font-medium text-lg text-stone-900 dark:text-stone-100">
                  {edu.degree}
                </h3>
                <span class="text-xs font-sans font-semibold text-brick-600 dark:text-brick-500 bg-warm-100 dark:bg-warm-800 px-2.5 py-0.5 rounded">
                  {edu.score}
                </span>
              </div>
              <p class="text-xs font-sans text-stone-600 dark:text-stone-400">
                {edu.institution}
              </p>
              {edu.details && (
                <p class="text-xs text-stone-500 font-sans pt-1">
                  {edu.details}
                </p>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 4. Initiatives & Social Action -->
    <section class="border-t border-warm-200 dark:border-warm-800 pt-10 space-y-8">
      <div class="space-y-1">
        <h2 class="text-xs uppercase tracking-widest text-brick-600 dark:text-brick-500 font-sans font-semibold">
          Initiatives & Social Action
        </h2>
        <p class="text-xs text-stone-500 font-sans">
          Healthcare AI governance think-tank and grassroots community education.
        </p>
      </div>

      <div class="divide-y divide-warm-200 dark:divide-warm-800">
        {leadershipExp.map((item) => (
          <div class="py-6 first:pt-0 grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-8 items-start">
            <div class="md:col-span-3 text-xs font-sans text-stone-500 dark:text-stone-400 font-medium md:pt-1">
              {item.period}
            </div>

            <div class="md:col-span-9 space-y-3">
              <div>
                <h3 class="font-serif font-medium text-xl text-stone-900 dark:text-stone-100">
                  {item.role}
                </h3>
                <div class="text-xs font-sans text-brick-600 dark:text-brick-500 font-medium pt-0.5">
                  {item.organization} <span class="text-stone-400 font-normal">· {item.location}</span>
                </div>
              </div>

              <ul class="space-y-2 text-sm text-stone-700 dark:text-stone-300 list-disc list-outside pl-4 font-sans leading-relaxed text-left">
                {item.description.map((d) => (
                  <li>{d}</li>
                ))}
              </ul>

              {item.link && (
                <div class="pt-1">
                  <a
                    href={item.link}
                    class="text-xs font-sans text-brick-600 dark:text-brick-500 hover:underline inline-flex items-center gap-1 font-medium"
                  >
                    Read detailed Pratigya Abhiyan memoir &rarr;
                  </a>
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 5. Mentors & Key Influences -->
    <section class="border-t border-warm-200 dark:border-warm-800 pt-10 space-y-8">
      <div class="space-y-1">
        <h2 class="text-xs uppercase tracking-widest text-brick-600 dark:text-brick-500 font-sans font-semibold">
          Mentors & Advisors
        </h2>
        <p class="text-xs text-stone-500 font-sans">
          Professors, research advisors, and executive leaders who have shaped my scientific and professional direction.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {mentors.map((m) => (
          <div class="p-4 rounded-xl border border-warm-200/90 dark:border-warm-800/90 bg-warm-50/50 dark:bg-warm-900/40 hover:border-brick-500/40 transition-colors space-y-2 flex flex-col justify-between">
            <div class="space-y-1">
              <div class="flex items-center justify-between text-[11px] font-sans">
                <span class="text-brick-600 dark:text-brick-500 font-medium uppercase tracking-wider text-[10px]">
                  {m.category === 'academic' ? 'Academic Mentor' : 'Industry Guidance'}
                </span>
                <span class="text-stone-400">{m.period}</span>
              </div>
              <h4 class="font-serif text-base font-medium text-stone-900 dark:text-stone-100">
                {m.name}
              </h4>
              <p class="text-xs font-sans text-stone-500 dark:text-stone-400">
                {m.role} · <span class="italic">{m.affiliation}</span>
              </p>
              <p class="text-xs font-sans text-stone-600 dark:text-stone-300 pt-1 leading-relaxed text-left">
                {m.relationship}
              </p>
            </div>

            <div class="pt-2 text-xs font-sans flex items-center justify-between border-t border-warm-200/60 dark:border-warm-800/60">
              {m.linkedin && (
                <a
                  href={m.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-brick-600 dark:text-brick-500 hover:underline font-medium inline-flex items-center gap-1"
                >
                  <span>LinkedIn</span>
                  <span>↗</span>
                </a>
              )}
              {m.website && (
                <a
                  href={m.website}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-stone-400 hover:text-stone-700 dark:hover:text-stone-200"
                >
                  Lab ↗
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 6. Selected Honors & Scholarly Reviewing -->
    <section class="border-t border-warm-200 dark:border-warm-800 pt-10 space-y-6">
      <h2 class="text-xs uppercase tracking-widest text-brick-600 dark:text-brick-500 font-sans font-semibold">
        Distinctions & Peer Review
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 text-sm font-sans">
        <div class="space-y-3">
          <span class="text-xs font-medium text-stone-500 block">Awards & Honors</span>
          <ul class="space-y-2.5 text-xs text-stone-700 dark:text-stone-300">
            {profile.awards.map((a) => (
              <li class="space-y-0.5">
                <span class="font-semibold text-stone-900 dark:text-stone-100 block">
                  {a.title} ({a.year})
                </span>
                <span class="text-stone-500">{a.description}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="space-y-3">
          <span class="text-xs font-medium text-stone-500 block">Scholarly Reviewer</span>
          <ul class="space-y-1.5 text-xs text-stone-600 dark:text-stone-400">
            {profile.service.map((s) => (
              <li>· {s}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Bottom Discussion CTA -->
    <div class="rounded-2xl border border-warm-200 dark:border-warm-800 bg-warm-100/60 dark:bg-warm-900/40 p-6 sm:p-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div class="space-y-1">
        <h3 class="font-serif text-xl font-medium text-stone-900 dark:text-stone-100">
          Interested in Research Collaboration or Discussion?
        </h3>
        <p class="text-xs sm:text-sm text-stone-600 dark:text-stone-400 font-sans">
          Whether regarding medical AI foundation models, differential geometry, or decision science, feel free to schedule a 30-minute conversation.
        </p>
      </div>
      <a
        href="https://calendly.com/prateekmittal154/30min"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-lg bg-brick-600 hover:bg-brick-700 text-white font-medium text-xs font-sans transition-colors shadow-sm whitespace-nowrap"
      >
        <span>Schedule 30-Min Meet</span>
        <span>&rarr;</span>
      </a>
    </div>

  </div>
</BaseLayout>
