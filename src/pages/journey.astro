---
import BaseLayout from '../layouts/BaseLayout.astro';
import { experiences, education } from '../data/experience';
import { profile } from '../data/profile';
---

<BaseLayout
  title="Journey & Leadership — Prateek Mittal"
  description="Career timeline, academic milestones, research labs, leadership initiatives, and professional service of Prateek Mittal."
>
  <div class="max-w-4xl mx-auto px-6 py-16">
    <!-- Header -->
    <div class="mb-14">
      <span class="text-xs font-mono uppercase tracking-widest text-gold-600 dark:text-gold-400 block mb-2">
        Curriculum Vitae
      </span>
      <h1 class="font-editorial text-4xl sm:text-5xl font-semibold text-stone-900 dark:text-stone-50 tracking-tight mb-4">
        The Journey & Leadership
      </h1>
      <p class="text-base sm:text-lg text-stone-600 dark:text-stone-400 font-editorial italic leading-relaxed">
        Tracing the convergence of production enterprise systems, academic research labs, and ethical initiatives.
      </p>
    </div>

    <!-- Experience Timeline -->
    <section class="mb-20">
      <h2 class="font-editorial text-2xl sm:text-3xl font-semibold text-stone-900 dark:text-stone-100 mb-8 flex items-center gap-3">
        <span>Experience & Research Positions</span>
        <span class="h-px flex-grow bg-stone-200 dark:bg-stone-800"></span>
      </h2>

      <div class="relative pl-6 sm:pl-8 border-l border-stone-200 dark:border-stone-800 space-y-12">
        {experiences.map((item) => (
          <div class="relative group">
            <!-- Timeline dot -->
            <div class="absolute -left-[31px] sm:-left-[39px] top-1.5 w-3.5 h-3.5 rounded-full border-2 border-stone-50 dark:border-stone-900 bg-gold-500 group-hover:scale-125 transition-transform" />

            <div class="space-y-2">
              <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
                <h3 class="font-editorial text-2xl font-semibold text-stone-900 dark:text-stone-100">
                  {item.role}
                </h3>
                <span class="text-xs font-mono text-stone-500 dark:text-stone-400">
                  {item.period}
                </span>
              </div>

              <div class="flex flex-wrap items-center gap-2 text-sm text-gold-600 dark:text-gold-400 font-medium">
                <span>{item.organization}</span>
                <span>·</span>
                <span class="text-stone-500 font-normal">{item.location}</span>
              </div>

              <ul class="mt-3 space-y-2 text-sm text-stone-600 dark:text-stone-400 list-disc list-outside pl-4 leading-relaxed">
                {item.description.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>

              {item.skills && (
                <div class="flex flex-wrap gap-1.5 pt-2">
                  {item.skills.map((skill) => (
                    <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-stone-100 dark:bg-stone-800/80 text-stone-600 dark:text-stone-300">
                      {skill}
                    </span>
                  ))}
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Education -->
    <section class="mb-20">
      <h2 class="font-editorial text-2xl sm:text-3xl font-semibold text-stone-900 dark:text-stone-100 mb-8 flex items-center gap-3">
        <span>Education</span>
        <span class="h-px flex-grow bg-stone-200 dark:bg-stone-800"></span>
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {education.map((edu) => (
          <div class="p-6 rounded-2xl border border-stone-200 dark:border-stone-800 bg-white/70 dark:bg-stone-900/60 backdrop-blur-sm space-y-2">
            <span class="text-xs font-mono text-gold-600 dark:text-gold-400">{edu.timeline}</span>
            <h3 class="font-editorial text-xl font-semibold text-stone-900 dark:text-stone-100">{edu.degree}</h3>
            <p class="text-sm text-stone-600 dark:text-stone-400 font-medium">{edu.institution}</p>
            <p class="text-xs font-mono font-semibold text-stone-800 dark:text-stone-200 pt-1">{edu.score}</p>
            {edu.details && <p class="text-xs text-stone-500 pt-1">{edu.details}</p>}
          </div>
        ))}
      </div>
    </section>

    <!-- Distinctions & Reviewing Service -->
    <section>
      <h2 class="font-editorial text-2xl sm:text-3xl font-semibold text-stone-900 dark:text-stone-100 mb-8 flex items-center gap-3">
        <span>Distinctions & Peer Review</span>
        <span class="h-px flex-grow bg-stone-200 dark:bg-stone-800"></span>
      </h2>

      <div class="space-y-6">
        <div class="p-6 rounded-2xl border border-stone-200 dark:border-stone-800 bg-white/70 dark:bg-stone-900/60 space-y-4">
          <h3 class="text-sm font-mono uppercase tracking-wider text-gold-600 dark:text-gold-400">Awards & Honors</h3>
          <ul class="space-y-3 text-sm text-stone-700 dark:text-stone-300">
            {profile.awards.map((award) => (
              <li class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-3">
                <span class="font-semibold text-stone-900 dark:text-stone-100">{award.title} ({award.year}):</span>
                <span class="text-stone-600 dark:text-stone-400">{award.description}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="p-6 rounded-2xl border border-stone-200 dark:border-stone-800 bg-white/70 dark:bg-stone-900/60 space-y-3">
          <h3 class="text-sm font-mono uppercase tracking-wider text-gold-600 dark:text-gold-400">Scholarly Reviewing Service</h3>
          <ul class="space-y-2 text-sm text-stone-600 dark:text-stone-400 font-sans">
            {profile.service.map((s) => (
              <li class="flex items-center gap-2">
                <span class="text-gold-500">✦</span>
                <span>{s}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
