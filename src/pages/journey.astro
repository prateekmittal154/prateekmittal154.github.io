---
import BaseLayout from '../layouts/BaseLayout.astro';
import { chapters, education } from '../data/experience';
import { profile } from '../data/profile';
---

<BaseLayout
  title="Journey & Milestones — Prateek Mittal"
  description="Personal timeline and milestones: Pratigya Abhiyan, medical AI research, Yale BrainLM, and Accenture."
>
  <div class="max-w-2xl mx-auto px-6 py-14 sm:py-20 space-y-16">
    
    <!-- Header -->
    <div class="space-y-3">
      <h1 class="text-3xl sm:text-4xl font-serif font-medium text-warm-900 dark:text-warm-50 tracking-tight">
        Journey & Milestones
      </h1>
      <p class="text-stone-600 dark:text-stone-400 font-sans text-sm leading-relaxed">
        A reflection on the formative chapters of learning, grassroots teaching, research, and industry.
      </p>
    </div>

    <!-- Chapters -->
    <div class="space-y-16">
      {chapters.map((chap) => (
        <section class="border-t border-warm-200 dark:border-warm-800 pt-8 space-y-5">
          <div class="space-y-1">
            <span class="text-xs font-sans text-terracotta-500 uppercase tracking-widest font-semibold block">
              Chapter {chap.number} · {chap.period}
            </span>
            <h2 class="text-2xl font-serif font-medium text-warm-900 dark:text-warm-50">
              {chap.title}
            </h2>
            <p class="text-xs text-stone-500 dark:text-stone-400 font-sans">
              {chap.subtitle}
            </p>
          </div>

          <blockquote class="italic text-stone-700 dark:text-stone-300 border-l-2 border-terracotta-500 pl-4 py-1 text-sm leading-relaxed">
            "{chap.essence}"
          </blockquote>

          <p class="text-sm text-stone-700 dark:text-stone-300 leading-relaxed font-serif">
            {chap.narrative}
          </p>

          {chap.highlightLink && (
            <div class="pt-1">
              <a
                href={chap.highlightLink.url}
                class="text-xs font-sans text-terracotta-500 hover:underline font-medium inline-flex items-center gap-1"
              >
                <span>{chap.highlightLink.text}</span>
                <span>&rarr;</span>
              </a>
            </div>
          )}

          <!-- Positions / Roles in this Chapter -->
          <div class="space-y-5 pt-3">
            {chap.items.map((item) => (
              <div class="space-y-2 text-sm border-t border-warm-100 dark:border-warm-800/60 pt-4">
                <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
                  <h3 class="font-serif font-medium text-base text-stone-900 dark:text-stone-100">
                    {item.role}
                  </h3>
                  <span class="text-xs font-sans text-stone-400">
                    {item.period}
                  </span>
                </div>
                <div class="text-xs font-sans text-stone-500 dark:text-stone-400">
                  {item.organization} · {item.location}
                </div>
                <ul class="space-y-1 text-xs text-stone-600 dark:text-stone-300 list-disc list-outside pl-4 leading-relaxed font-sans">
                  {item.description.map((d) => (
                    <li>{d}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>

    <!-- Education -->
    <section class="border-t border-warm-200 dark:border-warm-800 pt-10 space-y-6">
      <h2 class="text-2xl font-serif font-medium text-warm-900 dark:text-warm-50">
        Education
      </h2>
      <div class="space-y-6">
        {education.map((edu) => (
          <div class="space-y-1 text-sm">
            <div class="flex items-baseline justify-between gap-4">
              <h3 class="font-serif font-medium text-base text-stone-900 dark:text-stone-100">
                {edu.degree}
              </h3>
              <span class="text-xs font-sans text-stone-400">{edu.timeline}</span>
            </div>
            <div class="text-xs text-stone-600 dark:text-stone-400">
              {edu.institution} — <span class="font-semibold text-stone-800 dark:text-stone-200">{edu.score}</span>
            </div>
            {edu.details && (
              <p class="text-xs text-stone-500">{edu.details}</p>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- Distinctions & Reviewing -->
    <section class="border-t border-warm-200 dark:border-warm-800 pt-10 space-y-6">
      <h2 class="text-2xl font-serif font-medium text-warm-900 dark:text-warm-50">
        Honors & Service
      </h2>
      
      <div class="space-y-4 text-sm">
        <h3 class="text-xs font-sans uppercase tracking-widest text-terracotta-500 font-semibold">
          Selected Awards
        </h3>
        <ul class="space-y-2 text-xs text-stone-700 dark:text-stone-300 font-sans">
          {profile.awards.map((a) => (
            <li>
              <strong>{a.title} ({a.year})</strong>: {a.description}
            </li>
          ))}
        </ul>
      </div>

      <div class="space-y-2 text-sm pt-2">
        <h3 class="text-xs font-sans uppercase tracking-widest text-terracotta-500 font-semibold">
          Academic Reviewing
        </h3>
        <ul class="space-y-1 text-xs text-stone-600 dark:text-stone-400 font-sans">
          {profile.service.map((s) => (
            <li>· {s}</li>
          ))}
        </ul>
      </div>
    </section>

  </div>
</BaseLayout>
