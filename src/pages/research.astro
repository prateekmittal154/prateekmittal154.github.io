---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationCard from '../components/PublicationCard.astro';
import { publications } from '../data/publications';

const types = [
  { id: 'all', label: 'All Papers' },
  { id: 'journal', label: 'Journals' },
  { id: 'conference', label: 'Conferences' },
  { id: 'preprint', label: 'Preprints' },
  { id: 'presentation', label: 'Presentations' },
];
---

<BaseLayout
  title="Research & Publications — Prateek Mittal"
  description="Peer-reviewed publications and preprints in medical AI, differential geometry, and statistical learning."
>
  <div class="max-w-2xl mx-auto px-6 py-14 sm:py-20 space-y-10">
    <!-- Header -->
    <div class="space-y-3">
      <h1 class="text-3xl sm:text-4xl font-serif font-medium text-warm-900 dark:text-warm-50 tracking-tight">
        Research & Publications
      </h1>
      <p class="text-stone-600 dark:text-stone-400 font-sans text-sm leading-relaxed">
        Peer-reviewed journal papers (TMLR, Health Policy & Technology), conference contributions (MICCAI 2026, ICLR BrainLM), and preprints across differential geometry and healthcare accountability.
      </p>
    </div>

    <!-- Category Filters -->
    <div class="flex flex-wrap gap-2 border-b border-warm-200 dark:border-warm-800 pb-4 text-xs font-sans" id="pub-filters">
      {types.map((type) => (
        <button
          type="button"
          data-type={type.id}
          class={`px-3 py-1 rounded-full transition-colors ${
            type.id === 'all'
              ? 'bg-warm-900 text-warm-50 dark:bg-warm-100 dark:text-warm-900 font-medium'
              : 'text-stone-600 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-100 bg-warm-100/60 dark:bg-warm-800/40'
          }`}
        >
          {type.label}
        </button>
      ))}
    </div>

    <!-- Publications List -->
    <div class="space-y-8" id="pubs-list">
      {publications.map((pub) => (
        <div class="pub-item" data-type={pub.type}>
          <PublicationCard pub={pub} />
        </div>
      ))}
    </div>

    <div id="no-pubs" class="hidden text-center py-12 text-stone-400 font-serif italic text-sm">
      No publications found in this category.
    </div>
  </div>
</BaseLayout>

<script is:inline>
  const pubButtons = document.querySelectorAll('#pub-filters button');
  const pubItems = document.querySelectorAll('.pub-item');
  const noPubs = document.getElementById('no-pubs');

  pubButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      pubButtons.forEach((b) => {
        b.classList.remove('bg-warm-900', 'text-warm-50', 'dark:bg-warm-100', 'dark:text-warm-900', 'font-medium');
        b.classList.add('text-stone-600', 'dark:text-stone-400');
      });
      btn.classList.add('bg-warm-900', 'text-warm-50', 'dark:bg-warm-100', 'dark:text-warm-900', 'font-medium');
      btn.classList.remove('text-stone-600', 'dark:text-stone-400');

      const selected = btn.getAttribute('data-type');
      let count = 0;
      pubItems.forEach((item) => {
        const type = item.getAttribute('data-type');
        if (selected === 'all' || type === selected) {
          item.style.display = 'block';
          count++;
        } else {
          item.style.display = 'none';
        }
      });

      if (noPubs) {
        if (count === 0) noPubs.classList.remove('hidden');
        else noPubs.classList.add('hidden');
      }
    });
  });
</script>
