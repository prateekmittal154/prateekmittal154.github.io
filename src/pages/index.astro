---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';
import { publications } from '../data/publications';
import { getCollection } from 'astro:content';

const allWritings = await getCollection('writing');
const writings = allWritings.sort((a, b) => {
  if (a.slug === 'pratigya-abhiyan') return -1;
  if (b.slug === 'pratigya-abhiyan') return 1;
  return b.data.date.valueOf() - a.data.date.valueOf();
});

const featuredPapers = publications.filter((p) =>
  ['miccai-2026-inverse-protocol', 'tmlr-2026-subsampling', 'iclr-2024-brainlm', 'hlpt-2026-accountability'].includes(p.id)
);
---

<BaseLayout>
  <div class="max-w-2xl mx-auto px-6 py-14 sm:py-20 space-y-16">
    
    <!-- Introduction with Portrait -->
    <section class="space-y-6">
      <div class="flex flex-col-reverse sm:flex-row items-start sm:items-center justify-between gap-6 pb-4">
        <div class="space-y-1">
          <h1 class="text-3xl sm:text-4xl font-serif font-medium text-warm-900 dark:text-warm-50 tracking-tight">
            Prateek Mittal
          </h1>
          <p class="text-stone-600 dark:text-stone-400 font-sans text-sm">
            Researcher, writer, and analyst based in India.
          </p>
        </div>

        <!-- Real Portrait -->
        <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-full overflow-hidden border-2 border-warm-200 dark:border-warm-800 shadow-sm flex-shrink-0">
          <img
            src="/images/prateek.png"
            alt="Prateek Mittal"
            class="w-full h-full object-cover"
            loading="eager"
          />
        </div>
      </div>

      <!-- Human Narrative Intro -->
      <div class="space-y-4 text-stone-800 dark:text-stone-200 text-lg leading-relaxed">
        <p>
          Hello. I spend my time exploring the intersection between empirical science, social responsibility, and human contemplation.
        </p>
        <p>
          By day, I work on decision science and AI workflows at <strong>Accenture Strategy & Consulting</strong>, and research medical imaging and foundation models with the <strong>VEDAs Lab</strong> and collaborators from <strong>Yale University</strong>. 
        </p>
        <p>
          Long before any of that, I spent four formative years at <strong>Pratigya Abhiyan</strong> teaching children in underprivileged communities—an experience that completely changed how I think about education, privilege, and what technology ought to be for.
        </p>
        <p>
          In quieter hours, I write poetry in Hindi and English, study classical Indian philosophy, and reflect on the human condition.
        </p>
      </div>

      <!-- Quick Social Links -->
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2 pt-2 text-sm font-sans text-stone-600 dark:text-stone-400">
        <a href="mailto:prateekmittal154@gmail.com" class="text-terracotta-500 hover:underline">
          prateekmittal154@gmail.com
        </a>
        <span>·</span>
        <a href="https://github.com/prateekmittal154" target="_blank" rel="noopener noreferrer" class="hover:text-stone-900 dark:hover:text-stone-100 hover:underline">
          GitHub
        </a>
        <span>·</span>
        <a href="https://linkedin.com/in/prateek-mittal" target="_blank" rel="noopener noreferrer" class="hover:text-stone-900 dark:hover:text-stone-100 hover:underline">
          LinkedIn
        </a>
        <span>·</span>
        <a href="/journey" class="hover:text-stone-900 dark:hover:text-stone-100 hover:underline">
          CV & Journey
        </a>
      </div>
    </section>

    <!-- Pratigya Abhiyan Spotlight Feature -->
    <section class="border-t border-warm-200 dark:border-warm-800 pt-10 space-y-4">
      <span class="text-xs uppercase tracking-widest text-terracotta-500 font-sans font-semibold">
        Grassroots & Memoir
      </span>

      <h2 class="text-2xl font-serif font-medium text-warm-900 dark:text-warm-50">
        <a href="/writing/pratigya-abhiyan" class="hover:text-terracotta-500 transition-colors">
          Pratigya Abhiyan: Lessons from the Grassroots &rarr;
        </a>
      </h2>

      <blockquote class="italic text-stone-700 dark:text-stone-300 border-l-2 border-terracotta-500 pl-4 py-1 text-base">
        "Before I ever trained a neural network or decoded an fMRI scan, my most profound education took place on concrete floors with children whose eyes sparkled with unbroken curiosity."
      </blockquote>

      <p class="text-stone-700 dark:text-stone-300 text-base leading-relaxed">
        During my undergraduate years at Thapar Institute, I joined Pratigya Abhiyan as an educator teaching the children of migrant laborers and daily-wage earners. Over four years, I grew into the role of Academic Head—restructuring teaching frameworks, training fellow student volunteers, and learning that genuine intelligence is about empathy and clarity rather than complexity.
      </p>

      <div class="pt-1">
        <a
          href="/writing/pratigya-abhiyan"
          class="text-sm font-sans text-terracotta-500 hover:underline inline-flex items-center gap-1 font-medium"
        >
          Read the full essay & documentation &rarr;
        </a>
      </div>
    </section>

    <!-- Writing & Poems Index -->
    <section class="border-t border-warm-200 dark:border-warm-800 pt-10 space-y-6">
      <div class="flex items-baseline justify-between">
        <h2 class="text-2xl font-serif font-medium text-warm-900 dark:text-warm-50">
          Writings, Poetry & Essays
        </h2>
        <a href="/writing" class="text-xs font-sans text-stone-500 dark:text-stone-400 hover:text-terracotta-500">
          All Writings &rarr;
        </a>
      </div>

      <div class="space-y-6">
        {writings.slice(0, 4).map((post) => (
          <article class="group space-y-1">
            <div class="flex items-baseline justify-between gap-4">
              <h3 class="text-lg font-serif font-medium text-stone-900 dark:text-stone-100 group-hover:text-terracotta-500 transition-colors">
                <a href={`/writing/${post.slug}`}>
                  {post.data.title}
                </a>
              </h3>
              <time datetime={post.data.date.toISOString()} class="text-xs font-sans text-stone-400 dark:text-stone-500 flex-shrink-0">
                {new Intl.DateTimeFormat('en-US', { month: 'short', year: 'numeric' }).format(post.data.date)}
              </time>
            </div>
            <p class="text-sm text-stone-600 dark:text-stone-400 line-clamp-2 leading-relaxed">
              {post.data.description}
            </p>
          </article>
        ))}
      </div>
    </section>

    <!-- Selected Academic Research -->
    <section class="border-t border-warm-200 dark:border-warm-800 pt-10 space-y-6">
      <div class="flex items-baseline justify-between">
        <h2 class="text-2xl font-serif font-medium text-warm-900 dark:text-warm-50">
          Selected Research
        </h2>
        <a href="/research" class="text-xs font-sans text-stone-500 dark:text-stone-400 hover:text-terracotta-500">
          Complete Archive (15+ papers) &rarr;
        </a>
      </div>

      <p class="text-sm text-stone-600 dark:text-stone-400">
        Selected papers across medical image computing (MICCAI 2026), whole-brain foundation models (BrainLM at ICLR), robust statistics (TMLR), and healthcare AI accountability.
      </p>

      <div class="space-y-5">
        {featuredPapers.map((pub) => (
          <div class="space-y-1 text-sm">
            <div class="font-serif font-medium text-stone-900 dark:text-stone-100 text-base">
              {pub.url ? (
                <a href={pub.url} target="_blank" rel="noopener noreferrer" class="hover:text-terracotta-500 hover:underline">
                  {pub.title}
                </a>
              ) : (
                pub.title
              )}
            </div>
            <div class="text-xs text-stone-600 dark:text-stone-400">
              {pub.authors.join(', ')}
            </div>
            <div class="text-xs italic text-stone-500 dark:text-stone-400">
              {pub.venue} ({pub.year})
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Moments Teaser -->
    <section class="border-t border-warm-200 dark:border-warm-800 pt-10 space-y-4">
      <div class="flex items-baseline justify-between">
        <h2 class="text-2xl font-serif font-medium text-warm-900 dark:text-warm-50">
          Moments & Fragments
        </h2>
        <a href="/moments" class="text-xs font-sans text-stone-500 dark:text-stone-400 hover:text-terracotta-500">
          View Visual Diary &rarr;
        </a>
      </div>
      <p class="text-sm text-stone-600 dark:text-stone-400">
        Photographs and snapshots between classrooms, conference travels in Strasbourg, late nights at research whiteboards, and quiet books.
      </p>
    </section>

  </div>
</BaseLayout>
