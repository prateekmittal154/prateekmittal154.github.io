---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationCard from '../components/PublicationCard.astro';
import { profile } from '../data/profile';
import { publications } from '../data/publications';
import { researchProjects } from '../data/projects';
import { mentors } from '../data/mentors';
import { moments } from '../data/moments';
import { getCollection } from 'astro:content';

const allWritings = await getCollection('writing');
const writings = allWritings.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const featuredPapers = publications.filter((p) =>
  ['miccai-2026-inverse-protocol', 'tmlr-2026-subsampling', 'iclr-2024-brainlm', 'hlpt-2026-accountability'].includes(p.id)
);

const featuredProjects = researchProjects.slice(0, 4);
const previewMoments = moments.slice(0, 3);
---

<BaseLayout>
  <div class="max-w-5xl mx-auto px-6 sm:px-8 py-8 sm:py-12 space-y-12 sm:space-y-14">
    
    <!-- Hero: Structured 2-Column Architectural Layout -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">
      <!-- Left: Introduction & Narrative -->
      <div class="lg:col-span-7 space-y-6">
        <div class="space-y-2.5">
          <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full text-[11px] font-sans text-stone-600 dark:text-stone-300 bg-warm-100/80 dark:bg-warm-800/60 border border-warm-200/80 dark:border-warm-700/60">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>Gurugram & Faridabad, India · Decision Science @ Accenture</span>
          </div>
          <h1 class="text-4xl sm:text-5xl font-serif font-normal text-warm-900 dark:text-warm-50 tracking-tight leading-tight">
            Prateek Mittal
          </h1>
          <p class="text-base text-stone-600 dark:text-stone-400 font-sans font-medium">
            AI Decision Science Analyst · Medical AI Researcher · Writer
          </p>
        </div>

        <!-- Justified Narrative Bio in Warm Book Serif -->
        <div class="space-y-3.5 text-stone-800 dark:text-stone-200 font-serif text-[16px] sm:text-[17px] leading-[1.8] text-justified hyphens-auto">
          <p>
            I am an AI Decision Science Analyst at <strong>Accenture Strategy & Consulting</strong> (Gurugram) and an active medical-AI researcher collaborating with the <strong>Vision Exploration and Data Analytics (VEDAs) Lab</strong> at <strong>Motilal Nehru National Institute of Technology (MNNIT) Allahabad</strong> under the guidance of <strong>Dr. Joohi Chauhan</strong>—who has mentored me since my undergraduate years at Thapar Institute—and <strong>Dr. Prabal Pratap Singh</strong>.
          </p>
          <p>
            My early research trajectory was shaped in 2024 through remote collaboration with <strong>Dr. David van Dijk</strong> at <strong>Yale University</strong> on whole-brain foundation models (BrainLM, ICLR 2024). Today, my research investigates Riemannian differential geometry (Shape-DNA spectral analysis for pediatric brain lesions), inverse biological learning, and high-dimensional statistical robustness (TMLR 2026, 5 accepted works and 3 Oral presentations at MICCAI 2026 with the MICCAI Society Travel Grant).
          </p>
          <p>
            Earlier during my Bachelor’s degree, I dedicated four formative years to <strong>Pratigya Abhiyan</strong>, rising from a volunteer educator teaching children from underprivileged families to Academic Head. In industry, my time at Dr. Lal PathLabs was guided by CIO Munender Soperna, Gaurav Sharma, Dr. Reena Nakra, and Dr. Nimmi Kansal. In quieter hours, I write Hindi and English verse and reflect on philosophy.
          </p>
        </div>

        <!-- Action Links & 30-min Meet -->
        <div class="flex flex-wrap items-center gap-x-5 gap-y-2.5 pt-2 text-sm font-sans text-stone-600 dark:text-stone-400">
          <a
            href="https://calendly.com/prateekmittal154/30min"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-brick-600 hover:bg-brick-700 text-white font-medium text-xs transition-colors shadow-sm"
          >
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <span>Schedule 30m Meet</span>
            <span>&rarr;</span>
          </a>
          <a
            href="mailto:prateekmittal154@gmail.com"
            class="text-brick-600 dark:text-brick-500 font-medium hover:underline inline-flex items-center gap-1"
          >
            prateekmittal154@gmail.com
          </a>
          <span>·</span>
          <a
            href="https://github.com/prateekmittal154"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-stone-900 dark:hover:text-stone-100 hover:underline"
          >
            GitHub
          </a>
          <span>·</span>
          <a
            href="https://linkedin.com/in/prateek-mittal"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-stone-900 dark:hover:text-stone-100 hover:underline"
          >
            LinkedIn
          </a>
          <span>·</span>
          <a
            href="/journey"
            class="hover:text-stone-900 dark:hover:text-stone-100 hover:underline font-medium"
          >
            Journey & CV &rarr;
          </a>
        </div>
      </div>

      <!-- Right: Portrait & Key Affiliations Card -->
      <div class="lg:col-span-5 flex flex-col sm:flex-row lg:flex-col gap-6 items-center lg:items-end">
        <div class="w-full max-w-sm rounded-2xl overflow-hidden border border-warm-200 dark:border-warm-800 bg-warm-50 dark:bg-warm-900/60 p-4 shadow-sm space-y-4">
          <!-- Portrait -->
          <div class="aspect-[4/4.5] w-full rounded-xl overflow-hidden bg-warm-200 dark:bg-warm-800">
            <img
              src="/images/prateek.png"
              alt="Prateek Mittal"
              class="w-full h-full object-cover object-top"
              loading="eager"
            />
          </div>

          <!-- Structured Credentials -->
          <div class="space-y-2 text-xs font-sans text-stone-600 dark:text-stone-300 divide-y divide-warm-200/80 dark:divide-warm-800/80">
            <div class="flex justify-between items-baseline pt-1">
              <span class="text-stone-400">Current Role</span>
              <span class="font-medium text-stone-900 dark:text-stone-100 text-right">AI Analyst @ Accenture S&C</span>
            </div>
            <div class="flex justify-between items-baseline pt-2">
              <span class="text-stone-400">Primary Research</span>
              <span class="font-medium text-stone-900 dark:text-stone-100 text-right">MNNIT Allahabad (VEDAs Lab)</span>
            </div>
            <div class="flex justify-between items-baseline pt-2">
              <span class="text-stone-400">Formative Work</span>
              <span class="font-medium text-stone-900 dark:text-stone-100 text-right">Yale BrainLM (2024)</span>
            </div>
            <div class="flex justify-between items-baseline pt-2">
              <span class="text-stone-400">Key Mentors</span>
              <span class="font-medium text-stone-900 dark:text-stone-100 text-right">Dr. Joohi Chauhan · David van Dijk</span>
            </div>
            <div class="flex justify-between items-baseline pt-2">
              <span class="text-stone-400">Education</span>
              <span class="font-medium text-stone-900 dark:text-stone-100 text-right">BITS Pilani (9.50) · TIET (8.83)</span>
            </div>
            <div class="flex justify-between items-baseline pt-2">
              <span class="text-stone-400">Distinction</span>
              <span class="font-medium text-brick-600 dark:text-brick-500 text-right">MICCAI '26 Travel Grant (3 Orals)</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Highlights Strip: 4 Balanced Columns -->
    <section class="border-y border-warm-200 dark:border-warm-800 py-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        <div class="space-y-1">
          <span class="text-xs font-sans uppercase tracking-wider text-stone-400 block">Conference</span>
          <h4 class="font-serif text-lg font-medium text-stone-900 dark:text-stone-100">MICCAI 2026</h4>
          <p class="text-xs text-stone-500 font-sans">3 Oral Presentations · Travel Grant</p>
        </div>
        <div class="space-y-1">
          <span class="text-xs font-sans uppercase tracking-wider text-stone-400 block">Journal Theory</span>
          <h4 class="font-serif text-lg font-medium text-stone-900 dark:text-stone-100">TMLR 2026</h4>
          <p class="text-xs text-stone-500 font-sans">Robust High-Dim Subsampling</p>
        </div>
        <div class="space-y-1">
          <span class="text-xs font-sans uppercase tracking-wider text-stone-400 block">Formative NeuroAI</span>
          <h4 class="font-serif text-lg font-medium text-stone-900 dark:text-stone-100">BrainLM (ICLR)</h4>
          <p class="text-xs text-stone-500 font-sans">Yale 6,700h fMRI Model (2024)</p>
        </div>
        <div class="space-y-1">
          <span class="text-xs font-sans uppercase tracking-wider text-stone-400 block">Social Action</span>
          <h4 class="font-serif text-lg font-medium text-stone-900 dark:text-stone-100">Pratigya Abhiyan</h4>
          <p class="text-xs text-stone-500 font-sans">Academic Head & Volunteer (4 Years)</p>
        </div>
      </div>
    </section>

    <!-- Recent Writings & Musings (2-Column Grid Across Full Width) -->
    <section class="space-y-6">
      <div class="flex items-baseline justify-between border-b border-warm-200 dark:border-warm-800 pb-3">
        <div class="space-y-1">
          <h2 class="text-2xl font-serif font-medium text-warm-900 dark:text-warm-50">
            Writings, Poetry & Essays
          </h2>
          <p class="text-xs text-stone-500 font-sans">
            Reflections across medical AI, ethics, grassroots memoirs, and Hindi & English verse.
          </p>
        </div>
        <a href="/writing" class="text-xs font-sans text-brick-600 dark:text-brick-500 hover:underline font-medium">
          View all writings &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {writings.slice(0, 4).map((post) => (
          <article class="p-5 rounded-xl border border-warm-200/90 dark:border-warm-800/90 bg-warm-50/50 dark:bg-warm-900/40 hover:border-brick-500/50 transition-all flex flex-col justify-between space-y-3 group">
            <div class="space-y-2">
              <div class="flex items-center justify-between text-xs font-sans text-stone-400">
                <span class="text-brick-600 dark:text-brick-500 font-medium uppercase text-[11px] tracking-wider">
                  {post.data.category === 'poetry' ? 'Poetry' : post.data.category === 'memoirs' ? 'Memoir' : post.data.category === 'philosophy' ? 'Philosophy' : 'AI & Science'}
                </span>
                <time datetime={post.data.date.toISOString()}>
                  {new Intl.DateTimeFormat('en-US', { month: 'short', year: 'numeric' }).format(post.data.date)}
                </time>
              </div>

              <h3 class="text-lg font-serif font-medium text-stone-900 dark:text-stone-100 group-hover:text-brick-600 dark:group-hover:text-brick-500 transition-colors leading-snug">
                <a href={`/writing/${post.slug}`}>
                  {post.data.title}
                </a>
              </h3>

              <p class="text-sm text-stone-600 dark:text-stone-400 font-sans line-clamp-3 leading-relaxed text-left">
                {post.data.description}
              </p>
            </div>

            <div class="pt-2 text-xs font-sans text-brick-600 dark:text-brick-500 font-medium flex items-center justify-between">
              <span>{post.data.readingTime || '5 min read'}</span>
              <a href={`/writing/${post.slug}`} class="group-hover:translate-x-0.5 transition-transform">
                Read piece &rarr;
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Featured Research Projects & In-Depth Case Studies -->
    <section class="space-y-6">
      <div class="flex items-baseline justify-between border-b border-warm-200 dark:border-warm-800 pb-3">
        <div class="space-y-1">
          <h2 class="text-2xl font-serif font-medium text-warm-900 dark:text-warm-50">
            Featured Research Projects & Case Studies
          </h2>
          <p class="text-xs text-stone-500 font-sans">
            In-depth breakdowns of mathematical formulations, clinical novelty, and empirical validation across MNNIT Allahabad, Yale, and FEAIH.
          </p>
        </div>
        <a href="/research" class="text-xs font-sans text-brick-600 dark:text-brick-500 hover:underline font-medium">
          View all projects &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {featuredProjects.map((proj) => (
          <article class="rounded-xl overflow-hidden border border-warm-200 dark:border-warm-800 bg-warm-50/60 dark:bg-warm-900/40 hover:border-brick-500/50 transition-all flex flex-col justify-between group shadow-sm">
            <div class="aspect-[16/9] overflow-hidden bg-warm-200 dark:bg-warm-800 relative">
              <img
                src={proj.coverImage}
                alt={proj.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
              <div class="absolute top-3 left-3 bg-warm-950/85 backdrop-blur-md text-warm-50 text-[11px] font-sans px-2.5 py-0.5 rounded border border-warm-700/60 font-medium">
                {proj.venue}
              </div>
            </div>

            <div class="p-5 space-y-3 flex-grow flex flex-col justify-between">
              <div class="space-y-2">
                <div class="flex items-center justify-between text-xs font-sans text-stone-400">
                  <span class="text-brick-600 dark:text-brick-500 font-medium uppercase text-[10px] tracking-wider">
                    {proj.institution}
                  </span>
                  <span>{proj.period}</span>
                </div>

                <h3 class="font-serif text-lg font-medium text-stone-900 dark:text-stone-100 group-hover:text-brick-600 dark:group-hover:text-brick-500 transition-colors leading-snug">
                  <a href={`/research/${proj.id}`}>
                    {proj.title}
                  </a>
                </h3>

                <p class="text-xs text-stone-600 dark:text-stone-300 font-sans line-clamp-2 leading-relaxed text-left">
                  {proj.summary}
                </p>

                <!-- Mentors strip -->
                <div class="pt-1 text-[11px] font-sans text-stone-500">
                  <span class="font-medium text-stone-700 dark:text-stone-300">Mentors:</span> {proj.mentors.join(', ')}
                </div>
              </div>

              <!-- Metrics pills & Case Study Link -->
              <div class="pt-3 border-t border-warm-200/60 dark:border-warm-800/60 flex items-center justify-between text-xs font-sans">
                <div class="flex gap-1.5">
                  {proj.metrics.slice(0, 2).map((m) => (
                    <span class="bg-warm-100 dark:bg-warm-800/80 text-stone-700 dark:text-stone-300 text-[10px] px-2 py-0.5 rounded font-medium">
                      {m.label}: {m.value}
                    </span>
                  ))}
                </div>
                <a
                  href={`/research/${proj.id}`}
                  class="text-brick-600 dark:text-brick-500 font-medium hover:underline inline-flex items-center gap-0.5 group-hover:translate-x-0.5 transition-transform"
                >
                  <span>Case Study</span>
                  <span>&rarr;</span>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Selected Academic Publications -->
    <section class="space-y-6">
      <div class="flex items-baseline justify-between border-b border-warm-200 dark:border-warm-800 pb-3">
        <div class="space-y-1">
          <h2 class="text-2xl font-serif font-medium text-warm-900 dark:text-warm-50">
            Selected Publications
          </h2>
          <p class="text-xs text-stone-500 font-sans">
            Peer-reviewed papers across medical image computing, robust learning, and healthcare AI governance.
          </p>
        </div>
        <a href="/research" class="text-xs font-sans text-brick-600 dark:text-brick-500 hover:underline font-medium">
          Complete archive (15+ works) &rarr;
        </a>
      </div>

      <div class="space-y-6">
        {featuredPapers.map((pub) => (
          <PublicationCard pub={pub} />
        ))}
      </div>
    </section>

    <!-- Mentors & Collaborative Anchors -->
    <section class="space-y-6 border-t border-warm-200 dark:border-warm-800 pt-10">
      <div class="space-y-1 border-b border-warm-200 dark:border-warm-800 pb-3">
        <h2 class="text-2xl font-serif font-medium text-warm-900 dark:text-warm-50">
          Mentors & People Who Shaped My Journey
        </h2>
        <p class="text-xs text-stone-500 font-sans">
          No meaningful science or engineering happens in isolation. Deeply indebted to the professors, scientists, and industry leaders who have guided my research and professional growth.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {mentors.map((m) => (
          <div class="p-4 rounded-xl border border-warm-200/90 dark:border-warm-800/90 bg-warm-50/50 dark:bg-warm-900/40 hover:border-brick-500/40 transition-colors space-y-2.5 flex flex-col justify-between">
            <div class="space-y-1.5">
              <div class="flex items-center justify-between text-[11px] font-sans">
                <span class="text-brick-600 dark:text-brick-500 font-medium uppercase tracking-wider text-[10px]">
                  {m.category === 'academic' ? 'Academic Mentor' : 'Industry Guidance'}
                </span>
                <span class="text-stone-400">{m.period}</span>
              </div>

              <h4 class="font-serif text-base font-medium text-stone-900 dark:text-stone-100">
                {m.name}
              </h4>
              <p class="text-xs font-sans text-stone-500 dark:text-stone-400 font-medium">
                {m.role} · <span class="italic">{m.affiliation}</span>
              </p>

              <p class="text-xs font-sans text-stone-600 dark:text-stone-300 leading-relaxed pt-1 text-left">
                {m.relationship}
              </p>
            </div>

            <div class="pt-2 text-xs font-sans flex items-center justify-between border-t border-warm-200/60 dark:border-warm-800/60">
              {m.linkedin && (
                <a
                  href={m.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-brick-600 dark:text-brick-500 hover:underline font-medium inline-flex items-center gap-1"
                >
                  <span>LinkedIn Profile</span>
                  <span>↗</span>
                </a>
              )}
              {m.website && (
                <a
                  href={m.website}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-stone-400 hover:text-stone-700 dark:hover:text-stone-200"
                >
                  Lab Website ↗
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Moments Teaser: 3 Column Photo Strip -->
    <section class="space-y-6">
      <div class="flex items-baseline justify-between border-b border-warm-200 dark:border-warm-800 pb-3">
        <div class="space-y-1">
          <h2 class="text-2xl font-serif font-medium text-warm-900 dark:text-warm-50">
            Moments & Visual Diary
          </h2>
          <p class="text-xs text-stone-500 font-sans">
            Glimpses from conference journeys, whiteboard derivations, and grassroots classrooms.
          </p>
        </div>
        <a href="/moments" class="text-xs font-sans text-brick-600 dark:text-brick-500 hover:underline font-medium">
          View all photos &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
        {previewMoments.map((m) => (
          <div class="group rounded-xl overflow-hidden border border-warm-200 dark:border-warm-800 bg-warm-100 dark:bg-warm-900/60 shadow-sm space-y-2">
            <div class="aspect-[4/3] overflow-hidden">
              <img
                src={m.imageUrl}
                alt={m.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
            </div>
            <div class="p-3 pt-1 space-y-1">
              <span class="text-[10px] font-sans text-brick-600 dark:text-brick-500 uppercase tracking-wider block">
                {m.location || m.category}
              </span>
              <h4 class="font-serif text-sm font-medium text-stone-900 dark:text-stone-100 line-clamp-1">
                {m.title}
              </h4>
              <p class="text-xs text-stone-500 font-sans line-clamp-2 leading-relaxed">
                {m.caption}
              </p>
            </div>
          </div>
        ))}
      </div>
    </section>

  </div>
</BaseLayout>
