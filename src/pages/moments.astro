---
import BaseLayout from '../layouts/BaseLayout.astro';
import { moments } from '../data/moments';

const categories = [
  { id: 'all', label: 'All' },
  { id: 'grassroots', label: 'Pratigya & Teaching' },
  { id: 'research', label: 'Research & Labs' },
  { id: 'philosophy', label: 'Philosophy & Books' },
  { id: 'travel', label: 'Travel' },
];
---

<BaseLayout
  title="Moments & Frames — Prateek Mittal"
  description="Photographs and snapshots from Pratigya Abhiyan classrooms, research labs, conference journeys, and quiet books."
>
  <div class="max-w-5xl mx-auto px-6 sm:px-8 py-8 sm:py-12 space-y-10 sm:space-y-12">
    <!-- Header -->
    <div class="space-y-3 border-b border-warm-200 dark:border-warm-800 pb-6">
      <h1 class="text-3xl sm:text-4xl font-serif font-medium text-warm-900 dark:text-warm-50 tracking-tight">
        Moments & Fragments
      </h1>
      <p class="text-stone-600 dark:text-stone-400 font-sans text-sm leading-relaxed max-w-2xl text-left">
        A visual journal—between grassroots classrooms with Pratigya Abhiyan, research whiteboards, quiet stacks of books, and conference journeys.
      </p>
    </div>

    <!-- Category Filters -->
    <div class="flex flex-wrap gap-2 border-b border-warm-200 dark:border-warm-800 pb-4 text-xs font-sans" id="moment-filters">
      {categories.map((c) => (
        <button
          type="button"
          data-cat={c.id}
          class={`px-3.5 py-1.5 rounded-full transition-colors ${
            c.id === 'all'
              ? 'bg-warm-900 text-warm-50 dark:bg-warm-100 dark:text-warm-900 font-medium'
              : 'text-stone-600 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-100 bg-warm-100 dark:bg-warm-800/60'
          }`}
        >
          {c.label}
        </button>
      ))}
    </div>

    <!-- Photo Grid: Responsive Multi-Column Gallery -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" id="moments-grid">
      {moments.map((m) => (
        <figure class="moment-card rounded-xl overflow-hidden border border-warm-200 dark:border-warm-800 bg-warm-50/60 dark:bg-warm-900/40 p-3 space-y-3 shadow-sm hover:shadow-md transition-shadow" data-category={m.category}>
          <div class="aspect-[4/3] rounded-lg overflow-hidden bg-warm-200 dark:bg-warm-800">
            <img
              src={m.imageUrl}
              alt={m.title}
              class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
          </div>
          <figcaption class="space-y-1.5 px-1 pb-1">
            <div class="flex items-baseline justify-between text-[11px] font-sans text-stone-400">
              <span class="text-brick-600 dark:text-brick-500 font-medium uppercase tracking-wider">{m.location || m.category}</span>
              <span>{m.date}</span>
            </div>
            <h2 class="font-serif font-medium text-base text-stone-900 dark:text-stone-100 leading-snug">
              {m.title}
            </h2>
            <p class="text-xs text-stone-600 dark:text-stone-400 font-sans leading-relaxed text-left">
              {m.caption}
            </p>
          </figcaption>
        </figure>
      ))}
    </div>

    <!-- Drop Photos Note -->
    <div class="pt-8 border-t border-warm-200 dark:border-warm-800 text-xs font-sans text-stone-500 text-center">
      You can drop your personal photos into <code class="text-brick-600 dark:text-brick-500">public/images/moments/</code> and add them to <code class="text-brick-600 dark:text-brick-500">src/data/moments.ts</code>.
    </div>
  </div>
</BaseLayout>

<script is:inline>
  const filterBtns = document.querySelectorAll('#moment-filters button');
  const cards = document.querySelectorAll('.moment-card');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => {
        b.classList.remove('bg-warm-900', 'text-warm-50', 'dark:bg-warm-100', 'dark:text-warm-900', 'font-medium');
        b.classList.add('text-stone-600', 'dark:text-stone-400');
      });
      btn.classList.add('bg-warm-900', 'text-warm-50', 'dark:bg-warm-100', 'dark:text-warm-900', 'font-medium');
      btn.classList.remove('text-stone-600', 'dark:text-stone-400');

      const selected = btn.getAttribute('data-cat');
      cards.forEach((card) => {
        const cat = card.getAttribute('data-category');
        if (selected === 'all' || cat === selected) {
          card.style.display = 'block';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script>
