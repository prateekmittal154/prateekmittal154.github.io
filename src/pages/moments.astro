---
import BaseLayout from '../layouts/BaseLayout.astro';
import { moments } from '../data/moments';

const categories = [
  { id: 'all', label: 'All Frames' },
  { id: 'grassroots', label: '🌱 Grassroots & Pratigya' },
  { id: 'research', label: '🔬 Research & Labs' },
  { id: 'philosophy', label: '🏛️ Philosophy & Thought' },
  { id: 'life', label: '📚 Books & Stillness' },
  { id: 'travel', label: '🌿 Horizons & Travel' },
];
---

<BaseLayout
  title="Visual Moments & Fragments — Prateek Mittal"
  description="A visual journal of laboratory whiteboards, conference travels in Strasbourg, books, notebooks, and moments of quietude."
>
  <div class="max-w-5xl mx-auto px-6 py-16">
    <!-- Header -->
    <div class="max-w-2xl mb-12">
      <span class="text-xs font-mono uppercase tracking-widest text-gold-600 dark:text-gold-400 block mb-2">
        Visual Diary
      </span>
      <h1 class="font-editorial text-4xl sm:text-5xl font-semibold text-stone-900 dark:text-stone-50 tracking-tight mb-4">
        Moments & Fragments
      </h1>
      <p class="text-base sm:text-lg text-stone-600 dark:text-stone-400 font-editorial italic leading-relaxed">
        Visual glimpses from the journey—between conference halls in Strasbourg, late nights at the whiteboard, stacks of classical philosophy, and quiet mountain air.
      </p>
    </div>

    <!-- Category Filters -->
    <div class="flex flex-wrap gap-2 mb-10 pb-6 border-b border-stone-200 dark:border-stone-800" id="moment-filters">
      {categories.map((c) => (
        <button
          type="button"
          data-cat={c.id}
          class={`text-xs font-mono px-3.5 py-1.5 rounded-full border transition-all ${
            c.id === 'all'
              ? 'bg-stone-900 text-white dark:bg-stone-100 dark:text-stone-900 border-stone-900 dark:border-stone-100 font-semibold'
              : 'border-stone-200 dark:border-stone-800 text-stone-600 dark:text-stone-400 hover:border-gold-500 hover:text-gold-600 dark:hover:text-gold-400 bg-white/50 dark:bg-stone-900/40'
          }`}
        >
          {c.label}
        </button>
      ))}
    </div>

    <!-- Masonry-like Visual Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" id="moments-grid">
      {moments.map((m) => (
        <div
          class="moment-card group relative rounded-2xl overflow-hidden border border-stone-200/90 dark:border-stone-800/90 bg-stone-950 shadow-md"
          data-category={m.category}
        >
          <div class="h-72 overflow-hidden">
            <img
              src={m.imageUrl}
              alt={m.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 opacity-90 group-hover:opacity-100"
              loading="lazy"
            />
          </div>

          <!-- Caption Overlay -->
          <div class="p-5 bg-stone-900/90 dark:bg-stone-950/90 border-t border-stone-800 text-white space-y-1.5">
            <div class="flex items-center justify-between text-[11px] font-mono text-gold-400">
              <span>{m.location || m.category}</span>
              <span>{m.date}</span>
            </div>
            <h3 class="font-editorial text-lg font-medium text-stone-100">{m.title}</h3>
            <p class="text-xs text-stone-300 line-clamp-2 leading-relaxed font-sans">{m.caption}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Personalization Note -->
    <div class="mt-16 p-6 rounded-2xl border border-dashed border-stone-300 dark:border-stone-800 bg-stone-50/50 dark:bg-stone-900/20 text-center text-xs text-stone-500 font-mono">
      <span>✦ To add your own photos: drop any image in <code class="text-gold-600">public/images/moments/</code> and add an entry to <code class="text-gold-600">src/data/moments.ts</code>.</span>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  const filterBtns = document.querySelectorAll('#moment-filters button');
  const cards = document.querySelectorAll('.moment-card');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => {
        b.classList.remove('bg-stone-900', 'text-white', 'dark:bg-stone-100', 'dark:text-stone-900', 'font-semibold');
        b.classList.add('text-stone-600', 'dark:text-stone-400');
      });
      btn.classList.add('bg-stone-900', 'text-white', 'dark:bg-stone-100', 'dark:text-stone-900', 'font-semibold');
      btn.classList.remove('text-stone-600', 'dark:text-stone-400');

      const selected = btn.getAttribute('data-cat') || 'all';
      cards.forEach((card) => {
        const cat = card.getAttribute('data-category');
        if (selected === 'all' || cat === selected) {
          card.style.display = 'block';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script>
