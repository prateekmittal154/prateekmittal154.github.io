---
import type { Publication } from '../data/publications';

interface Props {
  pub: Publication;
}

const { pub } = Astro.props;
---

<article class="space-y-2.5 border-b border-warm-200/80 dark:border-warm-800/80 pb-6">
  <!-- Title -->
  <h3 class="font-serif text-lg font-medium text-stone-900 dark:text-stone-100 leading-snug">
    {pub.url ? (
      <a href={pub.url} target="_blank" rel="noopener noreferrer" class="hover:text-brick-600 dark:hover:text-brick-500 hover:underline">
        {pub.title}
      </a>
    ) : (
      pub.title
    )}
  </h3>

  <!-- Authors -->
  <p class="text-xs sm:text-sm text-stone-600 dark:text-stone-400 font-sans">
    {pub.authors.map((author, index) => {
      const isPrateek = author.includes('Prateek Mittal');
      return (
        <span>
          <span class={isPrateek ? 'font-semibold text-stone-900 dark:text-stone-100' : ''}>
            {author}
          </span>
          {index < pub.authors.length - 1 && ', '}
        </span>
      );
    })}
  </p>

  <!-- Venue & Year -->
  <p class="text-xs text-stone-500 dark:text-stone-400 italic font-serif">
    {pub.venue} ({pub.year})
  </p>

  <!-- Abstract if available -->
  {pub.abstract && (
    <p class="text-xs sm:text-[13px] text-stone-600 dark:text-stone-300 font-sans leading-relaxed text-justified hyphens-auto pt-0.5">
      {pub.abstract}
    </p>
  )}

  <!-- Badges & Action Links -->
  <div class="flex flex-wrap items-center gap-2.5 text-xs font-sans pt-1">
    {pub.badges && pub.badges.map((b) => (
      <span class="text-[11px] text-stone-600 dark:text-stone-300 bg-warm-100/80 dark:bg-warm-800/60 px-2 py-0.5 rounded border border-warm-200/60 dark:border-warm-700/60">
        {b}
      </span>
    ))}

    {pub.url && (
      <a
        href={pub.url}
        target="_blank"
        rel="noopener noreferrer"
        class="text-brick-600 dark:text-brick-500 hover:underline font-medium inline-flex items-center gap-0.5 ml-1"
      >
        <span>Paper</span>
        <span>&rarr;</span>
      </a>
    )}

    {pub.doi && (
      <a
        href={`https://doi.org/${pub.doi}`}
        target="_blank"
        rel="noopener noreferrer"
        class="text-stone-400 hover:text-stone-700 dark:hover:text-stone-200"
      >
        DOI
      </a>
    )}

    <!-- BibTeX Trigger -->
    <button
      type="button"
      data-bibtex-trigger={pub.id}
      class="text-stone-400 hover:text-stone-700 dark:hover:text-stone-200 ml-auto"
    >
      BibTeX
    </button>
  </div>

  <!-- Expandable BibTeX Drawer -->
  <div id={`bibtex-${pub.id}`} class="hidden mt-3 pt-3 border-t border-warm-200 dark:border-warm-800">
    <div class="relative">
      <pre class="bg-warm-100 dark:bg-warm-800/80 text-stone-800 dark:text-stone-200 p-3 rounded text-[11px] font-mono overflow-x-auto leading-relaxed">{pub.bibtex}</pre>
      <button
        type="button"
        data-copy-bibtex={pub.bibtex}
        class="absolute top-2 right-2 px-2 py-1 bg-warm-200 dark:bg-warm-700 hover:bg-stone-300 dark:hover:bg-stone-600 text-stone-800 dark:text-stone-200 rounded text-[10px] font-sans transition-colors"
      >
        Copy
      </button>
    </div>
  </div>
</article>

<script is:inline>
  document.querySelectorAll('[data-bibtex-trigger]').forEach((button) => {
    button.addEventListener('click', () => {
      const id = button.getAttribute('data-bibtex-trigger');
      const drawer = document.getElementById(`bibtex-${id}`);
      if (drawer) {
        drawer.classList.toggle('hidden');
      }
    });
  });

  document.querySelectorAll('[data-copy-bibtex]').forEach((button) => {
    button.addEventListener('click', async () => {
      const text = button.getAttribute('data-copy-bibtex');
      if (text) {
        await navigator.clipboard.writeText(text);
        const originalText = button.textContent;
        button.textContent = 'Copied';
        setTimeout(() => {
          button.textContent = originalText;
        }, 2000);
      }
    });
  });
</script>
