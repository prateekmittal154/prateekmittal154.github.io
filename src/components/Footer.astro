---
import { profile } from '../data/profile';
---

<footer class="mt-28 border-t border-stone-200/80 dark:border-stone-800/80 bg-parchment-100/50 dark:bg-ink-950/60 transition-colors">
  <div class="max-w-5xl mx-auto px-6 py-14">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 items-start">
      <!-- Epigraph & Identity -->
      <div class="md:col-span-7 space-y-4">
        <h3 class="font-editorial text-2xl font-medium tracking-tight text-stone-900 dark:text-stone-100">
          Prateek Mittal
        </h3>
        <p class="font-editorial italic text-stone-600 dark:text-stone-400 text-lg leading-relaxed max-w-lg">
          "Between the rigorous symmetry of an algorithm and the silent resonance of a poem lies the true dwelling of understanding."
        </p>
        <p class="text-xs uppercase tracking-widest text-stone-400 dark:text-stone-500 font-mono">
          Gurugram & Faridabad · India
        </p>
      </div>

      <!-- Quick Navigation & Connect -->
      <div class="md:col-span-5 flex flex-col justify-between h-full space-y-6">
        <div>
          <span class="text-xs font-semibold uppercase tracking-wider text-stone-400 dark:text-stone-500 block mb-3 font-mono">
            Direct Channels
          </span>
          <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-stone-700 dark:text-stone-300">
            {profile.social.map((s) => (
              <a
                href={s.url}
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-gold-600 dark:hover:text-gold-400 transition-colors underline decoration-stone-300 dark:decoration-stone-700 underline-offset-4"
              >
                {s.name}
              </a>
            ))}
          </div>
        </div>

        <div class="pt-4 border-t border-stone-200 dark:border-stone-800 text-xs text-stone-500 dark:text-stone-500 flex justify-between items-center font-mono">
          <span>&copy; {new Date().getFullYear()} Prateek Mittal</span>
          <span>Crafted with Astro & Intention</span>
        </div>
      </div>
    </div>
  </div>
</footer>
