---
import { profile } from '../data/profile';
---

<footer class="mt-12 sm:mt-16 border-t border-warm-200/80 dark:border-warm-800/80 text-xs font-sans text-stone-500 dark:text-stone-400">
  <div class="max-w-5xl mx-auto px-6 sm:px-8 py-8 flex flex-col sm:flex-row items-center justify-between gap-4">
    <div>
      <span>&copy; {new Date().getFullYear()} Prateek Mittal</span>
      <span class="mx-1.5">·</span>
      <span>Gurugram & Faridabad, India</span>
    </div>

    <div class="flex items-center gap-4">
      {profile.social.map((s) => (
        <a
          href={s.url}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-stone-900 dark:hover:text-stone-100 hover:underline"
        >
          {s.name}
        </a>
      ))}
    </div>
  </div>
</footer>
