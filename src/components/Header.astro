---
import ThemeToggle from './ThemeToggle.astro';

const navItems = [
  { label: 'Writing', href: '/writing' },
  { label: 'Journey', href: '/journey' },
  { label: 'Research', href: '/research' },
  { label: 'Moments', href: '/moments' },
  { label: 'About', href: '/about' },
];

const pathname = Astro.url.pathname;
---

<header class="border-b border-warm-200/80 dark:border-warm-800/80 transition-colors">
  <div class="max-w-3xl mx-auto px-6 h-18 py-5 flex items-center justify-between">
    <!-- Name / Home Link -->
    <a href="/" class="group flex items-baseline gap-2">
      <span class="font-serif text-xl sm:text-2xl font-medium tracking-tight text-warm-900 dark:text-warm-50 group-hover:text-terracotta-500 transition-colors">
        Prateek Mittal
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden sm:flex items-center gap-6 text-sm font-sans">
      {navItems.map((item) => {
        const isActive = pathname === item.href || (item.href !== '/' && pathname.startsWith(item.href));
        return (
          <a
            href={item.href}
            class={`transition-colors py-1 ${
              isActive
                ? 'text-terracotta-500 font-semibold underline decoration-terracotta-500 decoration-2 underline-offset-8'
                : 'text-stone-600 dark:text-stone-400 hover:text-stone-950 dark:hover:text-stone-100'
            }`}
          >
            {item.label}
          </a>
        );
      })}

      <div class="w-px h-3.5 bg-warm-200 dark:bg-warm-700 mx-1" />

      <ThemeToggle />
    </nav>

    <!-- Mobile Nav Toggle -->
    <div class="flex items-center gap-3 sm:hidden">
      <ThemeToggle />
      <button
        id="mobile-menu-button"
        type="button"
        class="p-1.5 text-stone-600 dark:text-stone-300 hover:text-stone-900 dark:hover:text-white"
        aria-label="Toggle menu"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 6h16M4 12h16m-7 6h7" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown -->
  <div id="mobile-menu" class="hidden sm:hidden border-t border-warm-200 dark:border-warm-800 bg-warm-100/60 dark:bg-warm-900/60 px-6 py-4">
    <div class="flex flex-col gap-3 font-sans text-sm">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="py-1 text-stone-700 dark:text-stone-300 hover:text-terracotta-500"
        >
          {item.label}
        </a>
      ))}
    </div>
  </div>
</header>

<script is:inline>
  const menuBtn = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  if (menuBtn && menu) {
    menuBtn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }
</script>
