---
import BaseLayout from './BaseLayout.astro';

interface Props {
  entry: {
    data: {
      title: string;
      description: string;
      date: Date;
      category: 'ai-research' | 'philosophy' | 'poetry' | 'memoirs';
      tags: string[];
      coverImage?: string;
      readingTime?: string;
      epigraph?: string;
      language?: 'en' | 'hi' | 'both';
    };
  };
}

const { entry } = Astro.props;
const { title, description, date, category, tags, coverImage, readingTime, epigraph, language } = entry.data;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(date);
---

<BaseLayout title={`${title} — Prateek Mittal`} description={description} image={coverImage}>
  <article class="max-w-3xl mx-auto px-6 sm:px-8 py-8 sm:py-12 space-y-8 sm:space-y-10">
    <!-- Back Navigation -->
    <div>
      <a
        href="/writing"
        class="text-xs font-sans text-stone-500 dark:text-stone-400 hover:text-brick-600 dark:hover:text-brick-500 inline-flex items-center gap-1 font-medium"
      >
        <span>&larr;</span>
        <span>Back to writings</span>
      </a>
    </div>

    <!-- Header -->
    <header class={`space-y-4 border-b border-warm-200 dark:border-warm-800 pb-8 ${category === 'poetry' ? 'text-center' : ''}`}>
      <div class={`text-xs font-sans uppercase tracking-wider text-brick-600 dark:text-brick-500 font-semibold ${category === 'poetry' ? 'text-center' : ''}`}>
        {category === 'poetry' ? 'Poetry' : category === 'memoirs' ? 'Memoir' : category === 'philosophy' ? 'Philosophy' : 'Research Notes'}
      </div>

      <h1 class={`text-3xl sm:text-4xl md:text-5xl font-serif font-medium text-warm-900 dark:text-warm-50 leading-tight ${language === 'hi' || language === 'both' ? 'font-devanagari' : ''}`}>
        {title}
      </h1>

      <p class="text-base sm:text-lg text-stone-600 dark:text-stone-400 font-serif italic leading-relaxed text-left">
        {description}
      </p>

      <div class={`flex flex-wrap items-center gap-3 text-xs font-sans text-stone-400 pt-2 ${category === 'poetry' ? 'justify-center' : ''}`}>
        <time datetime={date.toISOString()}>{formattedDate}</time>
        <span>·</span>
        <span>{readingTime || '5 min read'}</span>
        {tags && tags.length > 0 && (
          <>
            <span>·</span>
            <div class="flex gap-2 text-stone-500 dark:text-stone-400">
              {tags.map((tag) => (
                <span>#{tag}</span>
              ))}
            </div>
          </>
        )}
      </div>

      {epigraph && (
        <blockquote class="italic text-stone-700 dark:text-stone-300 border-l-2 border-brick-500 pl-4 py-2 text-base my-6 text-left">
          "{epigraph}"
        </blockquote>
      )}
    </header>

    <!-- Cover Image if present -->
    {coverImage && (
      <div class="rounded-xl overflow-hidden border border-warm-200 dark:border-warm-800 shadow-sm">
        <img
          src={coverImage}
          alt={title}
          class="w-full max-h-[460px] object-cover"
          loading="lazy"
        />
      </div>
    )}

    <!-- Content Body with Justified Text -->
    <div class={`prose prose-stone dark:prose-invert max-w-none font-serif text-lg leading-relaxed text-stone-800 dark:text-stone-200 ${category === 'poetry' ? '' : 'text-justified hyphens-auto'}`}>
      <slot />
    </div>

    <!-- Author Footnote -->
    <div class="pt-8 border-t border-warm-200 dark:border-warm-800 flex items-center justify-between text-sm">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-full overflow-hidden border border-warm-200 dark:border-warm-800 flex-shrink-0">
          <img src="/images/prateek.png" alt="Prateek Mittal" class="w-full h-full object-cover" />
        </div>
        <div>
          <span class="font-serif font-medium text-stone-900 dark:text-stone-100 block">Prateek Mittal</span>
          <span class="text-xs font-sans text-stone-500">AI Decision Science & Medical AI</span>
        </div>
      </div>

      <a href="/writing" class="text-xs font-sans text-brick-600 dark:text-brick-500 hover:underline font-medium">
        More writings &rarr;
      </a>
    </div>
  </article>
</BaseLayout>
