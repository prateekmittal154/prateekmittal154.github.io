---
import BaseLayout from './BaseLayout.astro';

interface Props {
  entry: {
    data: {
      title: string;
      description: string;
      date: Date;
      category: 'ai-research' | 'philosophy' | 'poetry' | 'memoirs';
      tags: string[];
      coverImage?: string;
      readingTime?: string;
      epigraph?: string;
      language?: 'en' | 'hi' | 'both';
    };
  };
}

const { entry } = Astro.props;
const { title, description, date, category, tags, coverImage, readingTime, epigraph, language } = entry.data;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(date);

const categoryLabels: Record<string, string> = {
  'ai-research': '🔬 AI & Empirical Science',
  'philosophy': '🏛️ Philosophy & Ethics',
  'poetry': '✍️ Poetry & Verse (काव्य)',
  'memoirs': '🌿 Memoirs & Reflections',
};
---

<BaseLayout title={`${title} — Prateek Mittal`} description={description} image={coverImage}>
  <article class="max-w-4xl mx-auto px-6 py-12 md:py-16">
    <!-- Breadcrumb / Stream Pill -->
    <div class="mb-8 flex items-center justify-between">
      <a
        href="/writing"
        class="inline-flex items-center gap-2 text-xs font-mono tracking-wider text-stone-500 hover:text-gold-600 dark:hover:text-gold-400 transition-colors uppercase"
      >
        <span>&larr;</span>
        <span>The Writing Codex</span>
      </a>
      <span class="text-xs font-mono px-2.5 py-1 rounded-full bg-stone-100 dark:bg-stone-800 text-stone-700 dark:text-stone-300 border border-stone-200 dark:border-stone-700">
        {categoryLabels[category] || category}
      </span>
    </div>

    <!-- Header -->
    <header class={`mb-12 ${category === 'poetry' ? 'text-center max-w-2xl mx-auto' : ''}`}>
      <h1 class={`font-editorial text-4xl sm:text-5xl md:text-6xl font-semibold tracking-tight text-stone-900 dark:text-stone-50 leading-[1.15] mb-6 ${language === 'hi' || language === 'both' ? 'font-devanagari' : ''}`}>
        {title}
      </h1>

      <p class="text-lg md:text-xl text-stone-600 dark:text-stone-400 font-editorial italic leading-relaxed mb-6">
        {description}
      </p>

      <!-- Metadata Row -->
      <div class={`flex flex-wrap items-center gap-4 text-xs font-mono text-stone-500 dark:text-stone-400 pb-6 border-b border-stone-200 dark:border-stone-800 ${category === 'poetry' ? 'justify-center' : ''}`}>
        <time datetime={date.toISOString()}>{formattedDate}</time>
        <span>·</span>
        <span>{readingTime || '5 min read'}</span>
        {tags && tags.length > 0 && (
          <>
            <span>·</span>
            <div class="flex gap-2">
              {tags.map((tag) => (
                <span class="text-stone-600 dark:text-stone-400">#{tag}</span>
              ))}
            </div>
          </>
        )}
      </div>

      <!-- Epigraph Quote Card -->
      {epigraph && (
        <div class="my-8 py-4 px-6 rounded-lg bg-stone-100/70 dark:bg-stone-900/50 border-l-2 border-gold-500 text-stone-700 dark:text-stone-300 font-editorial italic text-lg text-center">
          "{epigraph}"
        </div>
      )}
    </header>

    <!-- Cover Image -->
    {coverImage && (
      <div class="mb-14 rounded-2xl overflow-hidden border border-stone-200/80 dark:border-stone-800/80 shadow-md">
        <img
          src={coverImage}
          alt={title}
          class="w-full max-h-[460px] object-cover"
          loading="lazy"
        />
      </div>
    )}

    <!-- Content Body -->
    <div class={`prose prose-stone dark:prose-invert max-w-none prose-headings:font-editorial prose-headings:font-semibold prose-a:text-gold-600 dark:prose-a:text-gold-400 prose-img:rounded-xl text-stone-800 dark:text-stone-200 text-lg leading-relaxed ${category === 'poetry' ? 'poetry-mode' : ''}`}>
      <slot />
    </div>

    <!-- Article Footer / Author Note -->
    <div class="mt-20 pt-10 border-t border-stone-200 dark:border-stone-800 flex flex-col sm:flex-row items-center justify-between gap-6">
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded-full overflow-hidden border border-gold-500/50 bg-stone-200 dark:bg-stone-800 flex-shrink-0">
          <img src="/images/prateek.png" alt="Prateek Mittal" class="w-full h-full object-cover" />
        </div>
        <div>
          <h4 class="font-editorial text-lg font-semibold text-stone-900 dark:text-stone-100">Prateek Mittal</h4>
          <p class="text-xs text-stone-500 font-mono">Decision Science · Medical AI · Thought & Verse</p>
        </div>
      </div>

      <a
        href="/writing"
        class="text-xs font-mono text-gold-600 dark:text-gold-400 hover:underline uppercase tracking-wider"
      >
        Explore More Writings &rarr;
      </a>
    </div>
  </article>
</BaseLayout>
